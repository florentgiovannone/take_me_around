VITE_API_PROXY_TARGET=

# Dashboard API (local dev) — must match TMA_backend DASHBOARD_PASSWORD
# (same value as the main dashboard). Sent as X-Dashboard-Password.
# Set this for one-click Unlock; leave empty to show a password field.
VITE_DASHBOARD_PASSWORD=

# Optional — Southwell locales (npm run translate:southwell)
# Same language set as gallery/museum: fr, ja, ar, de, es, ko, zh, pt, tr, it
# DEEPL_API_KEY=
# DEEPL_API_URL=https://api-free.deepl.com

# Optional — section audio generation (npm run audio:sections)
# Localized: node scripts/generate-section-audio.mjs --work southwell-minster --skip-en
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=                 # default English sections
# ELEVENLABS_VOICE_ID_REV=McCpKDz9Fm00UGapoXxs  # Southwell donate (Reverend) — separate from ELEVENLABS_VOICE_ID
# ELEVENLABS_VOICE_ID_FR=
# ELEVENLABS_VOICE_ID_JA=
# ELEVENLABS_VOICE_ID_AR=
# ELEVENLABS_VOICE_ID_DE=
# ELEVENLABS_VOICE_ID_ES=
# ELEVENLABS_VOICE_ID_KO=
# ELEVENLABS_VOICE_ID_ZH=
# ELEVENLABS_VOICE_ID_PT=
# ELEVENLABS_VOICE_ID_TR=
# ELEVENLABS_VOICE_ID_IT=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
