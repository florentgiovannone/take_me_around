{
  "name": "@tma/app-museum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "test:host": "vite --host 0.0.0.0 --port 4173 --mode test",
    "build": "node scripts/write-netlify-redirects.mjs && tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "preview:test:host": "vite preview --host 0.0.0.0 --port 4173",
    "translate:hoa": "node scripts/translate-hoa.mjs",
    "generate:hoa-audio": "node scripts/generate-hoa-audio.mjs",
    "translate:two-fridas": "node scripts/translate-artwork.mjs --artwork two-fridas",
    "generate:two-fridas-audio": "node scripts/generate-artwork-audio.mjs --artwork two-fridas",
    "translate:sutton-hoo-helmet": "node scripts/translate-artwork.mjs --artwork sutton-hoo-helmet",
    "generate:sutton-hoo-helmet-audio": "node scripts/generate-artwork-audio.mjs --artwork sutton-hoo-helmet",
    "translate:mona-lisa": "node scripts/translate-artwork.mjs --artwork mona-lisa",
    "generate:mona-lisa-audio": "node scripts/generate-artwork-audio.mjs --artwork mona-lisa",
    "translate:royal-game-of-ur": "node scripts/translate-artwork.mjs --artwork royal-game-of-ur",
    "generate:royal-game-of-ur-audio": "node scripts/generate-artwork-audio.mjs --artwork royal-game-of-ur",
    "translate:qingming-festival": "node scripts/translate-artwork.mjs --artwork qingming-festival",
    "generate:qingming-festival-audio": "node scripts/generate-artwork-audio.mjs --artwork qingming-festival",
    "translate:rosetta-stone": "node scripts/translate-artwork.mjs --artwork rosetta-stone",
    "generate:rosetta-stone-audio": "node scripts/generate-artwork-audio.mjs --artwork rosetta-stone",
    "translate:fallen-madonna": "node scripts/translate-artwork.mjs --artwork fallen-madonna",
    "generate:fallen-madonna-audio": "node scripts/generate-artwork-audio.mjs --artwork fallen-madonna"
  },
  "dependencies": {
    "@tma/dashboard-scope": "*",
    "@tma/dashboard-ui": "*",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "sass": "^1.99.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.10"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.0.0-rc.17",
    "lightningcss-linux-x64-gnu": "^1.32.0"
  }
