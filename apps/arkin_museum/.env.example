# Copy to .env.local (never commit .env.local)
ELEVENLABS_API_KEY=

# Florence voice ID — copy from ElevenLabs → Voices → My Voices → Florence → Copy voice ID
ELEVENLABS_VOICE_ID=

# Turkish narration voice (defaults to ELEVENLABS_VOICE_ID when unset)
ELEVENLABS_VOICE_ID_TR=

# Dashboard (local dev) — must match TMA_backend DASHBOARD_PASSWORD_ARKIN
VITE_DASHBOARD_PASSWORD=rodin-dashboard
VITE_API_PROXY_TARGET=

# DeepL — translate exhibition copy (EN → TR). Free tier: api-free.deepl.com
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com

# Maintenance mode — blocks public exhibition pages (dashboard stays available). Set to false to restore the site.
VITE_ARKIN_MAINTENANCE_MODE=true
