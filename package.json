{
  "name": "takemearound",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @tma/app-gallery && npm run build -w @tma/app-museum && npm run build -w @tma/app-arkin-museum && npm run build -w @tma/app-dashboard && npm run build -w @tma/app-church-of-england && npm run build -w @tma/app-i-am-a-safe-pet && npm run build -w @tma/app-fair-future",
    "build:gallery": "npm run build -w @tma/app-gallery",
    "build:museum": "npm run build -w @tma/app-museum",
    "build:arkin-museum": "npm run build -w @tma/app-arkin-museum",
    "build:dashboard": "npm run build -w @tma/app-dashboard",
    "build:church-of-england": "npm run build -w @tma/app-church-of-england",
    "build:i-am-a-safe-pet": "npm run build -w @tma/app-i-am-a-safe-pet",
    "build:fair-future": "npm run build -w @tma/app-fair-future",
    "dev": "node scripts/dev.mjs",
    "test": "node --test scripts/lib/*.test.mjs",
    "dev:gallery": "npm run dev -w @tma/app-gallery",
    "dev:museum": "npm run dev -w @tma/app-museum",
    "dev:arkin-museum": "npm run dev -w @tma/app-arkin-museum",
    "dev:dashboard": "npm run dev -w @tma/app-dashboard",
    "dev:church-of-england": "npm run dev -w @tma/app-church-of-england",
    "dev:i-am-a-safe-pet": "npm run dev -w @tma/app-i-am-a-safe-pet",
    "dev:fair-future": "npm run dev -w @tma/app-fair-future"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.5.2",
    "concurrently": "^10.0.4"
  }
}
